{
  "name": "web-app-air-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "yarn generate:middleware-envs",
    "dev": "cross-env TEST=true next dev",
    "prebuild": "yarn generate:middleware-envs",
    "build": "next build",
    "prebuild:test": "yarn generate:middleware-envs",
    "build:test": "cross-env TEST=true next build",
    "start": "next start",
    "generate:middleware-envs": "node middleware-envs-generator.mjs",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/swagger-typescript-api.ts",
    "lint": "eslint src",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "cypress": "cypress open",
    "cypress:headless": "cross-env TEST=true npx cypress run --component && npx cypress run --e2e",
    "jest": "jest --watch",
    "jest:coverage": "jest --coverage",
    "test": "concurrently \"yarn jest\" \"yarn cypress\"",
    "coverage": "yarn nyc report --reporter=text-summary",
    "coverage:merge": "istanbul-merge --out coverage/summary/coverage-final.json coverage/cypress/coverage-final.json coverage/jest/coverage-final.json && nyc report --reporter=lcov -t coverage/summary --report-dir coverage/summary --check-coverage false",
    "coverage:enable-babel": "node -e \"require('fs').copyFileSync('babel.coverage.js','babel.config.js')\"",
    "coverage:disable-babel": "node -e \"try{require('fs').unlinkSync('babel.config.js')}catch(e){}\"",
    "test:coverage": "yarn coverage:enable-babel && yarn cypress:headless && yarn jest:coverage && yarn coverage:merge; yarn coverage:disable-babel",
    "type-check": "next typegen && tsc --pretty --noEmit"
  },
  "dependencies": {
    "@next/bundle-analyzer": "16.2.12",
    "@sk-web-gui/core": "4.6.2",
    "@sk-web-gui/lucide-icon": "1.1.2",
    "@sk-web-gui/react": "3.1.3",
    "@tailwindcss/forms": "^0.5.11",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.5.4",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^0.471.1",
    "next": "16.4.1",
    "next-i18n-router": "^5.5.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.0",
    "recharts": "^3.10.1",
    "sass": "^1.106.0",
    "sharp": "^0.35.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.0.3",
    "@eslint/js": "^9.39.5",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "~6.9.1",
    "@types/jest": "^29.5.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.1",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "cypress": "^15.21.1",
    "dotenv": "^16.6.1",
    "envalid": "^8.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "istanbul-merge": "^2.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.31",
    "postcss-import": "^16.2.0",
    "prettier": "^3.9.10",
    "swagger-typescript-api": "^13.13.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.15",
    "typescript": "6.0.3"
  },
  "resolutions": {
    "sharp": "^0.35.5",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.6"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ]
}
