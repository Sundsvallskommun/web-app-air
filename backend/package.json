{
  "name": "backend",
  "version": "0.0.1",
  "description": "TypeScript + Express + Routing Controllers API Server",
  "author": "",
  "license": "ISC",
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon",
    "generate:contracts": "cross-env NODE_ENV=development ts-node ./src/swagger-typescript-api.ts",
    "build": "tsc && tsc-alias",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "deploy:prod": "npm run build && pm2 start ecosystem.config.js --only prod",
    "deploy:dev": "pm2 start ecosystem.config.js --only dev",
    "type-check": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@node-saml/passport-saml": "^5.1.1",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "class-validator-jsonschema": "^5.2.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "envalid": "^8.2.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "memorystore": "^1.6.8",
    "morgan": "^1.12.1",
    "passport": "^0.7.0",
    "qs": "^6.16.1",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "routing-controllers-openapi": "^5.0.1",
    "session-file-store": "^1.5.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.7",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "swagger-typescript-api": "^13.13.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "resolutions": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3"
  }
}
